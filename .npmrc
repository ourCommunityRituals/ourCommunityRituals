# nosemgrep: package_managers.npm.npm-missing-minimum-release-age.npm-missing-minimum-release-age
# WHY suppressed (not fixed): the npm-missing-minimum-release-age rule is a whole-file
# "missing setting" match, so it anchors on line 1 — the nosemgrep must live here, not on a
# setting line. A real minimum-release-age policy needs pnpm >= 10.16 (minimumReleaseAge);
# adding min-release-age on pinned pnpm@9.15.0 would be an inert no-op that only silences the
# scanner without enforcing anything. Real enforcement is tracked under OSE-1089.
strict-peer-dependencies=false
auto-install-peers=true
resolution-mode=highest
