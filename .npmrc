# npm-missing-minimum-release-age is suppressed on the first setting line below:
# a minimum-release-age policy needs pnpm >= 10.16 (minimumReleaseAge); adding
# the key on pinned pnpm@9.15.0 would be an inert no-op. Tracked under OSE-1089.
strict-peer-dependencies=false # nosemgrep
auto-install-peers=true
resolution-mode=highest
