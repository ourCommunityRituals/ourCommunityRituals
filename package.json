{
  "name": "ourcommunityrituals-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for OCR shared packages (packages/*). Sibling app repos (OSE, OW, OA, OER, OSM, OSG, OSP, OSR, OCR-docs) are independent git repos and NOT part of this workspace.",
  "type": "module",
  "scripts": {
    "flags:build": "pnpm --filter @ocr/flags build",
    "flags:test": "pnpm --filter @ocr/flags test",
    "flags:test:gate": "pnpm --filter @ocr/flags test:gate",
    "flags:level0": "pnpm --filter @ocr/flags test:level0",
    "flags:generate": "pnpm --filter @ocr/flags generate",
    "flags:check:generated": "pnpm --filter @ocr/flags check:generated",
    "flags:lint": "pnpm --filter @ocr/flags lint",
    "tokens:build": "pnpm --filter @ocr/tokens build",
    "tokens:test": "pnpm --filter @ocr/tokens test",
    "tokens:typecheck": "pnpm --filter @ocr/tokens typecheck",
    "tokens:check:generated": "pnpm --filter @ocr/tokens check:generated",
    "tokens:check:raw": "pnpm --filter @ocr/tokens check:raw",
    "ui:test": "pnpm --filter @ocr/ui test",
  "ui:typecheck": "pnpm --filter @ocr/ui typecheck",
  "ui:check:generated": "pnpm --filter @ocr/ui check:generated",
    "ui:contrast": "pnpm --filter @ocr/ui contrast",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "postcss@<8.5.23": "^8.5.23",
      "moment@<2.31.0": "^2.31.0",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "vite@<6.4.3": "^7.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^16.3.0",
    "typescript-eslint": "^8.45.0"
  }
}
