{
  "name": "@ocr/ui",
  "version": "0.1.0",
  "description": "Shared design tokens, stylesheet, and native-JS HTML partials for the ourCommunityRituals fleet. No framework layer.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".":          "./src/index.ts",
    "./tailwind": "./src/tailwind.ts",
    "./css":      "./src/css.ts",
    "./tokens":   "./src/tokens.ts",
    "./design-system/tokens.css": "./design-system/tokens.css",
    "./design-system/bundle.css": "./design-system/components/bundle.css"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": { "optional": true }
  },
  "scripts": {
    "test": "vitest run tests/",
    "scan": "tsx scripts/scan.ts",
    "typecheck": "tsc --noEmit",
    "compile-tokens": "node design-system/compile-tokens.mjs",
    "check:generated": "node design-system/compile-tokens.mjs --check",
    "check:stylesheet": "node scripts/stylesheet-coverage.mjs --check",
    "build-previews": "tsx scripts/build-previews.mjs",
    "check:previews": "tsx scripts/build-previews.mjs --check"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
