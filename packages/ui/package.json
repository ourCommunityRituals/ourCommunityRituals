{
  "name": "@ocr/ui",
  "version": "0.1.0",
  "description": "Shared design tokens, stylesheet, and HTML partials for the ourCommunityRituals fleet.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".":          "./src/index.ts",
    "./tailwind": "./src/tailwind.ts",
    "./css":      "./src/css.ts",
    "./tokens":   "./src/tokens.ts"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": { "optional": true }
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "scan": "tsx scripts/scan.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
