{
  "name": "@ocr/ui",
  "version": "0.1.0",
  "description": "Shared design tokens, stylesheet, and HTML partials for the ourCommunityRituals fleet.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".":          "./src/index.ts",
    "./react":    "./src/react/index.ts",
    "./tailwind": "./src/tailwind.ts",
    "./css":      "./src/css.ts",
    "./tokens":   "./src/tokens.ts",
    "./design-system/tokens.css": "./design-system/tokens.css",
    "./design-system/bundle.css": "./design-system/components/bundle.css"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "tailwindcss": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "tailwindcss": { "optional": true }
  },
  "scripts": {
    "test": "vitest run tests/",
    "scan": "tsx scripts/scan.ts",
    "typecheck": "tsc --noEmit",
    "compile-tokens": "node design-system/compile-tokens.mjs",
    "check:generated": "node design-system/compile-tokens.mjs --check",
    "contrast": "tsx scripts/verify-contrast.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.3.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
