{
  "name": "@ocr/runner-fleet",
  "version": "0.1.0",
  "description": "GitHub Actions self-hosted runner fleet manager — token rotation, health watchdog, auto-recovery, observability dashboard",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "runner-fleet": "./src/cli.ts"
  },
  "files": ["src", "dist", "docs"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  }
}
