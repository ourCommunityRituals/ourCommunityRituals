# ourCommunityRituals root-repo .gitignore
#
# This repo exists to host the SHARED workspace (pnpm-workspace.yaml) and
# reusable packages (packages/*) that bind OCR Brain contracts to runtime
# code. Each OCR app lives in its OWN git repo as a sibling directory —
# those repos are NOT tracked here. They are discovered by humans/tools
# via sibling-directory convention, not by being part of this repo.

# ─── Sibling OCR app repos (each is its own git repo) ─────────────────
OCR-docs/
ourAirwaves/
ourEventRings/
ourSharedEvents/
ourSharedGames/
ourSharedMagnets/
ourSharedPulse/
ourSharedRecords/
ourWKRP/

# ─── Self-hosted GitHub Actions runner ────────────────────────────────
actions-runner/

# --- Local-only tooling ------------------------------------------------
# Hub clone cache used by ourSharedEvents/scripts/ci-stage-ocr-workspace.sh
_ocr-workspace-cache/
# Per-machine dev-server config for the desktop app preview
.claude/launch.json
# Git worktrees for WIP (see docs/decisions/wip-worktrees.md)
.claude/worktrees/

# ─── Build + tooling artifacts ────────────────────────────────────────
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.next/
**/.next/
coverage/
**/coverage/
.vitest/
**/.vitest/
__pycache__/
**/__pycache__/
*.pyc

# ─── Editor / OS ──────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.log

# ─── Env / secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Runner fleet — local config contains PAT ─────────────────────────
packages/runner-fleet/fleet.config.json
fleet-dashboard.html

# ─── Self-hosted runner installs + local ops scripts (machine-local) ──
# Full runner working directories and the ad-hoc provisioning/bounce
# scripts live only on the host machine — they carry local paths/creds
# and are never part of the repo. See docs/ops runbook for canonical
# runner tooling (OSE tools/runner/provision-runner.ps1).
/actions-runner-*/
/_*.ps1
/_run-hidden.vbs
/reconfig-*.ps1

# @ocr/tokens ships its generated CSS/JSON: check-generated.mjs compares
# against them and consumers import ./dist/tokens.css directly.
!packages/tokens/dist/
!packages/tokens/dist/**
